{
  "contract_version": "catalog-bench/v1",
  "kind": "scenario",
  "id": "iceberg-rest.commit.failure-recovery",
  "version": 1,
  "title": "Iceberg REST commit response-loss recovery",
  "description": "Exercise exact commit retry before upstream admission and reconciliation after an accepted response is lost, with config-gated idempotency content binding.",
  "family": "operations",
  "classification": "strict-v1",
  "tags": ["fault-injection", "commit", "retry", "accepted-state-ambiguity", "idempotency"],
  "capabilities": [
    {"capability": "iceberg-rest.namespace.create", "level": "required", "description": "Create an isolated fixture namespace."},
    {"capability": "iceberg-rest.namespace.drop", "level": "required", "description": "Clean the isolated fixture namespace."},
    {"capability": "iceberg-rest.table.create", "level": "required", "description": "Create an isolated fixture table."},
    {"capability": "iceberg-rest.table.load", "level": "required", "description": "Observe committed state through a direct catalog endpoint."},
    {"capability": "iceberg-rest.table.update", "level": "required", "description": "Commit a standard set-properties update with current requirements."},
    {"capability": "iceberg-rest.table.drop", "level": "required", "description": "Clean the isolated fixture table."},
    {"capability": "iceberg-rest.table.commit.exact-retry", "level": "required", "description": "Retry the exact request after a disconnected response."},
    {"capability": "iceberg-rest.idempotency-key.content-binding", "level": "optional", "description": "When config advertises idempotency-key-lifetime, bind a key to exact request content."}
  ],
  "parameters": {
    "fault_action": "disconnect",
    "before_fault_injections": 1,
    "after_fault_injections": 1,
    "idempotency_advertisement_pointers": ["/idempotency-key-lifetime", "/defaults/idempotency-key-lifetime", "/overrides/idempotency-key-lifetime"],
    "state_observation": "direct-catalog-endpoint"
  },
  "steps": [
    {"id": "prepare-fixture", "actor": "harness", "operation": "iceberg-rest.fixture.create", "description": "Create a run-owned namespace and table through standard Iceberg REST."},
    {"id": "lose-before-upstream", "actor": "catalog", "operation": "table.commit.disconnect-before-upstream", "description": "Disconnect one commit before forwarding it.", "depends_on": ["prepare-fixture"]},
    {"id": "reconcile-before", "actor": "harness", "operation": "table.load-and-retry-exact", "description": "Prove the property is absent, retry the exact request, and prove it is present.", "depends_on": ["lose-before-upstream"]},
    {"id": "lose-after-upstream", "actor": "catalog", "operation": "table.commit.disconnect-after-upstream", "description": "Forward one commit, observe upstream success, and disconnect its response.", "depends_on": ["reconcile-before"]},
    {"id": "reconcile-after", "actor": "harness", "operation": "table.load-and-retry-exact", "description": "Prove accepted state directly and retry exactly, accepting equivalent success or safe CAS conflict.", "depends_on": ["lose-after-upstream"]},
    {"id": "probe-idempotency-drift", "actor": "client", "operation": "table.commit.reject-idempotency-content-drift", "description": "When advertised, send different content with the same UUIDv7 key and prove it cannot mutate state.", "depends_on": ["reconcile-after"]},
    {"id": "clean-fixture", "actor": "harness", "operation": "iceberg-rest.fixture.drop", "description": "Drop the table and namespace and remove the fresh Docker project and volumes.", "depends_on": ["probe-idempotency-drift"]}
  ],
  "assertions": [
    {"id": "before-request-disconnected", "step": "lose-before-upstream", "required": true, "description": "The first before-upstream commit returns no HTTP response.", "check": {"kind": "custom", "name": "querygraph/catalog-bench/client-disconnected-v1", "configuration": {"expected": true}}},
    {"id": "before-state-unchanged", "step": "reconcile-before", "required": true, "description": "Direct load proves the property is absent before retry.", "check": {"kind": "custom", "name": "querygraph/catalog-bench/property-state-v1", "configuration": {"before_retry": null}}},
    {"id": "before-exact-retry-accepted", "step": "reconcile-before", "required": true, "description": "The exact retry succeeds and the property becomes accepted.", "check": {"kind": "http-status", "allowed": [200]}},
    {"id": "after-request-disconnected", "step": "lose-after-upstream", "required": true, "description": "The client receives no response although the proxy observed upstream success.", "check": {"kind": "custom", "name": "querygraph/catalog-bench/ambiguous-upstream-success-v1", "configuration": {"upstream_status": 200}}},
    {"id": "after-state-accepted", "step": "reconcile-after", "required": true, "description": "Direct load proves the property was accepted before retry.", "check": {"kind": "custom", "name": "querygraph/catalog-bench/property-state-v1", "configuration": {"before_retry": "accepted"}}},
    {"id": "after-exact-retry-safe", "step": "reconcile-after", "required": true, "description": "Exact retry is equivalent success or a safe conflict, with accepted state unchanged.", "check": {"kind": "http-status", "allowed": [200, 409]}},
    {"id": "idempotency-content-bound", "step": "probe-idempotency-drift", "required": false, "description": "When advertised, same-key different-content cannot mutate state and should return conflict rather than cached success.", "check": {"kind": "custom", "name": "querygraph/catalog-bench/idempotency-content-binding-v1", "configuration": {"expected_status": 409, "state_mutated": false}}},
    {"id": "fixture-cleaned", "step": "clean-fixture", "required": true, "description": "The table, namespace, project containers, and project volumes are removed.", "check": {"kind": "custom", "name": "querygraph/catalog-bench/fresh-project-cleanup-v1", "configuration": {"catalog_fixture": "removed", "volumes": "removed"}}}
  ]
}
