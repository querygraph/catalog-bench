  "outcome": {
    "status": "fail",
    "failure": {
      "category": "catalog",
      "summary": "Lakekeeper returned PostgreSQL deadlock-backed HTTP 503 errors in every contention round.",
      "detail": "All six rounds completed setup, warmup, sequential commits, final-state attribution, MinIO object-growth audit, and cleanup, but every round violated zero-request-errors. The transcript records 58 HTTP 503 responses: 11 in conditioning and 47 across the five measured rounds. Reviewed Lakekeeper logs attribute the responses to CatalogBackendError after PostgreSQL reported a deadlock while setting table properties. PostgreSQL logs show concurrent DELETE plus INSERT ON CONFLICT UPDATE statements on table_properties waiting on transaction ShareLocks. Expected stale Iceberg races are classified separately as HTTP 409 conflicts; these 503 responses are catalog backend failures and therefore remain unranked. This Lakekeeper path uses PostgreSQL and is unrelated to LakeCat's Turso state store.",
      "retryable": false,
      "evidence": [
        "contention-transcript",
        "materialization-review"
      ]
    }
  },
