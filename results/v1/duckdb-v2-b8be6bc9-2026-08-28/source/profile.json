  "services": [
    {
      "component": "catalog-bench-engine",
      "role": "engine-runner"
    },
    {
      "component": "minio",
      "role": "shared-object-store",
      "endpoint": "http://minio:9000",
      "settings": {
        "bucket": "warehouse",
        "host_ports": "none",
        "path_style_access": true,
        "region": "us-east-1",
        "state_volume": "minio-data"
      }
    },
    {
      "component": "postgresql",
      "role": "lakekeeper-private-state-store",
      "endpoint": "postgresql://postgresql:5432",
      "settings": {
        "database": "lakekeeper",
        "isolation": "dedicated process, role, database, and named volume",
        "state_volume": "lakekeeper-postgres-data"
      }
    },
    {
      "component": "lakecat",
      "role": "iceberg-rest-catalog",
      "endpoint": "http://trino-lakecat:8181/catalog",
      "private_state": "lakecat-turso",
      "settings": {
        "state_mode": "file-backed Turso",
        "state_volume": "trino-lakecat-data",
        "warehouse": "local",
        "warehouse_location": "s3://warehouse/lakecat"
      }
    },
    {
      "component": "polaris",
      "role": "iceberg-rest-catalog",
      "endpoint": "http://polaris:8181/api/catalog",
      "private_state": "postgresql",
      "settings": {
        "state_isolation": "dedicated Polaris database/schema",
        "warehouse": "s3://warehouse/"
      }
    },
    {
      "component": "gravitino",
      "role": "iceberg-rest-catalog",
      "endpoint": "http://gravitino:9001/iceberg",
      "settings": {
        "state_backend": "file-backed SQLite JDBC inside the pinned image",
        "warehouse": "s3://warehouse/"
      }
    },
    {
      "component": "lakekeeper",
      "role": "iceberg-rest-catalog",
      "endpoint": "http://lakekeeper:8181/catalog",
      "private_state": "postgresql",
      "settings": {
        "config_warehouse": "bench",
        "project_id": "00000000-0000-0000-0000-000000000000",
        "readiness": "healthcheck plus typed bootstrap, warehouse reconciliation, and config negotiation",
        "state_isolation": "dedicated PostgreSQL process, role, database, and named volume",
        "warehouse": "s3://warehouse/lakekeeper"
      }
    },
    {
      "component": "duckdb-iceberg",
      "role": "engine-connector"
    },
    {
      "component": "duckdb",
      "role": "stock-engine"
    }
  ],
