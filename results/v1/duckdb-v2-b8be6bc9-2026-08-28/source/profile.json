        "config": {
          "path": "/v1/config",
          "query": {
            "warehouse": "local"
          }
        },
        "route_prefix": {
          "kind": "unprefixed"
        }
      },
      "authentication": {
        "kind": "anonymous"
      },
      "request_handling": {
        "kind": "protocol-native"
      },
      "capabilities": {
        "mode": "exercise-all"
      }
    },
