{
  "$defs": {
    "AdapterCapabilityCoverage": {
      "description": "An exhaustive disposition of the profile capability vocabulary.\n\n`exercise-all` is the DRY representation when every capability should run.\n`explicit` partitions the vocabulary when one or more capabilities are known\nto be unsupported. Exercising a capability is not a claim that it will pass.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "exercise-all",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exercise": {
              "items": {
                "$ref": "#/$defs/CapabilityId"
              },
              "type": "array"
            },
            "mode": {
              "const": "explicit",
              "type": "string"
            },
            "unsupported": {
              "items": {
                "$ref": "#/$defs/UnsupportedAdapterCapability"
              },
              "type": "array"
            }
          },
          "required": [
            "mode",
            "exercise",
            "unsupported"
          ],
          "type": "object"
        }
      ]
    },
    "AdapterRequestHandling": {
      "description": "Whether an adapter preserves the request and response semantics under test.\n\nA behavior-changing shim remains representable so experimental evidence can\ndisclose it, but it cannot masquerade as a protocol-native adapter.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "protocol-native",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "component": {
              "$ref": "#/$defs/ComponentId"
            },
            "description": {
              "type": "string"
            },
            "kind": {
              "const": "behavior-changing-shim",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "component",
            "description"
          ],
          "type": "object"
        }
      ]
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "A file or URI together with the digest that makes the reference immutable.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "location": {
          "description": "Bundle-relative path or public URI.",
          "type": "string"
        },
        "media_type": {
          "type": "string"
        }
      },
      "required": [
        "location",
        "media_type",
        "digest"
      ],
      "type": "object"
    },
    "BuildConfiguration": {
      "additionalProperties": false,
      "description": "Reproducible build settings that materially affect a native executable.",
      "properties": {
        "compiler_flags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "locked": {
          "type": "boolean"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "toolchain": {
          "type": "string"
        }
      },
      "required": [
        "toolchain",
        "target",
        "profile",
        "locked"
      ],
      "type": "object"
    },
    "CapabilityId": {
      "description": "Stable identifier for a scenario capability.",
      "type": "string"
    },
    "CapabilityLimitationSource": {
      "enum": [
        "catalog",
        "adapter"
      ],
      "type": "string"
    },
    "CatalogAdapter": {
      "additionalProperties": false,
      "description": "One catalog's complete, profile-pinned harness binding.",
      "properties": {
        "authentication": {
          "$ref": "#/$defs/CatalogAuthentication"
        },
        "capabilities": {
          "$ref": "#/$defs/AdapterCapabilityCoverage"
        },
        "catalog": {
          "$ref": "#/$defs/ComponentId"
        },
        "endpoint": {
          "$ref": "#/$defs/CatalogEndpoint"
        },
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "protocol": {
          "$ref": "#/$defs/CatalogProtocol"
        },
        "request_handling": {
          "$ref": "#/$defs/AdapterRequestHandling"
        }
      },
      "required": [
        "catalog",
        "protocol",
        "endpoint",
        "authentication",
        "request_handling",
        "capabilities"
      ],
      "type": "object"
    },
    "CatalogAuthentication": {
      "description": "Authentication performed by the harness before sending protocol requests.\nSecret values never belong in a profile.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "anonymous",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "client_id_env": {
              "description": "Environment variable names only; secret values never enter profiles.",
              "type": "string"
            },
            "client_secret_env": {
              "type": "string"
            },
            "kind": {
              "const": "oauth2-client-credentials",
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "token_path": {
              "description": "Token route relative to the catalog base URL.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "token_path",
            "scope",
            "client_id_env",
            "client_secret_env"
          ],
          "type": "object"
        }
      ]
    },
    "CatalogCapability": {
      "additionalProperties": false,
      "description": "One capability in the profile's immutable interoperability vocabulary.\n\nDefinitions live once at profile level. Each catalog adapter must exercise\nthe entire vocabulary or explicitly partition it into exercised and\nunsupported capabilities.",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/CapabilityId"
        },
        "specification": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "description"
      ],
      "type": "object"
    },
    "CatalogConfigRequest": {
      "additionalProperties": false,
      "description": "The catalog's configuration request relative to its adapter base URL.",
      "properties": {
        "path": {
          "type": "string"
        },
        "query": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Sanitized routing parameters only, such as Lakekeeper's warehouse name.",
          "type": "object"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "CatalogEndpoint": {
      "additionalProperties": false,
      "description": "Exact, behaviorally relevant Iceberg REST routing for one catalog.",
      "properties": {
        "base_url": {
          "description": "Docker-network URL through the end of the deployment-specific mount path.",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/CatalogConfigRequest"
        },
        "create_table_location": {
          "description": "A standard optional `createTable.location`, never a rewritten request.",
          "type": [
            "string",
            "null"
          ]
        },
        "route_prefix": {
          "$ref": "#/$defs/CatalogRoutePrefix"
        }
      },
      "required": [
        "base_url",
        "config",
        "route_prefix"
      ],
      "type": "object"
    },
    "CatalogProtocol": {
      "enum": [
        "iceberg-rest-v1"
      ],
      "type": "string"
    },
    "CatalogRoutePrefix": {
      "description": "How the standard `{prefix}` path segment is resolved for catalog requests.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unprefixed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "static",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "config_json_pointer": {
              "type": "string"
            },
            "kind": {
              "const": "negotiated",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "config_json_pointer"
          ],
          "type": "object"
        }
      ]
    },
    "Component": {
      "additionalProperties": false,
      "description": "Exact identity of a catalog, client, engine, service, or tool.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/RuntimeArtifact"
        },
        "build": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildConfiguration"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRevision"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "version",
        "artifact"
      ],
      "type": "object"
    },
    "ComponentId": {
      "description": "Identifier for a component within a profile.",
      "type": "string"
    },
    "ComponentKind": {
      "enum": [
        "catalog",
        "client",
        "connector",
        "engine",
        "object-store",
        "state-store",
        "benchmark-harness",
        "container-runtime",
        "validator",
        "converter",
        "other"
      ],
      "type": "string"
    },
    "ContractVersion": {
      "description": "The only contract version accepted by these Rust types.",
      "oneOf": [
        {
          "const": "catalog-bench/v1",
          "description": "The initial public contract.",
          "type": "string"
        }
      ]
    },
    "Digest": {
      "additionalProperties": false,
      "description": "A content hash. Hash algorithms are explicit so a future contract can add one\nwithout changing the meaning of existing values.",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/DigestAlgorithm"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "type": "object"
    },
    "DigestAlgorithm": {
      "enum": [
        "sha256"
      ],
      "type": "string"
    },
    "ExecutionMode": {
      "enum": [
        "docker-compose",
        "kubernetes",
        "host-processes",
        "mixed"
      ],
      "type": "string"
    },
    "ExecutionPlatform": {
      "additionalProperties": false,
      "description": "Shared execution substrate. Actual per-run hardware is captured in each\nresult's environment manifest.",
      "properties": {
        "architecture": {
          "type": "string"
        },
        "container_runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "mode": {
          "$ref": "#/$defs/ExecutionMode"
        },
        "network": {
          "type": "string"
        },
        "operating_system": {
          "type": "string"
        },
        "shared_object_store": {
          "$ref": "#/$defs/ComponentId"
        },
        "warehouse_uri": {
          "type": "string"
        }
      },
      "required": [
        "operating_system",
        "architecture",
        "mode",
        "network",
        "shared_object_store",
        "warehouse_uri"
      ],
      "type": "object"
    },
    "ImageDigestScope": {
      "description": "What an image digest addresses. Registry indexes, platform manifests, and\nlocal Docker image IDs are different objects and must not be conflated.",
      "enum": [
        "index",
        "platform-manifest",
        "local-image"
      ],
      "type": "string"
    },
    "ProfileDocumentKind": {
      "enum": [
        "profile"
      ],
      "type": "string"
    },
    "ProfileId": {
      "description": "Stable identifier for an execution profile.",
      "type": "string"
    },
    "ProfilePurpose": {
      "enum": [
        "historical-reproduction",
        "current-candidate",
        "conformance",
        "performance",
        "fault-injection"
      ],
      "type": "string"
    },
    "ProfileReadiness": {
      "description": "Whether all artifacts needed to execute the profile have immutable identities.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "runnable",
              "type": "string"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "explanation": {
              "type": "string"
            },
            "status": {
              "const": "draft",
              "type": "string"
            },
            "unresolved_artifacts": {
              "items": {
                "$ref": "#/$defs/ComponentId"
              },
              "type": "array"
            }
          },
          "required": [
            "status",
            "unresolved_artifacts",
            "explanation"
          ],
          "type": "object"
        }
      ]
    },
    "RuntimeArtifact": {
      "description": "The deployable artifact used for a component.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "$ref": "#/$defs/Digest"
            },
            "digest_scope": {
              "$ref": "#/$defs/ImageDigestScope"
            },
            "embedded_artifacts": {
              "items": {
                "$ref": "#/$defs/ArtifactReference"
              },
              "type": "array"
            },
            "kind": {
              "const": "container-image",
              "type": "string"
            },
            "platform_digest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reference": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reference",
            "digest_scope",
            "digest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "executable": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ArtifactReference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "const": "source-build",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "digest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ecosystem": {
              "type": "string"
            },
            "kind": {
              "const": "package",
              "type": "string"
            },
            "package": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "ecosystem",
            "package",
            "version"
          ],
          "type": "object"
        }
      ]
    },
    "ServiceBinding": {
      "additionalProperties": false,
      "description": "A component's neutral role and endpoint within the profile topology.",
      "properties": {
        "component": {
          "$ref": "#/$defs/ComponentId"
        },
        "endpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "private_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "type": "string"
        },
        "settings": {
          "additionalProperties": true,
          "description": "Sanitized, behaviorally relevant settings only. Secrets are forbidden.",
          "type": "object"
        }
      },
      "required": [
        "component",
        "role"
      ],
      "type": "object"
    },
    "SourceRevision": {
      "additionalProperties": false,
      "description": "Immutable source identity for a component built from source.",
      "properties": {
        "extensions": {
          "additionalProperties": true,
          "type": "object"
        },
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repository",
        "revision"
      ],
      "type": "object"
    },
    "UnsupportedAdapterCapability": {
      "additionalProperties": false,
      "description": "A capability deliberately not exercised for one catalog.",
      "properties": {
        "attributed_to": {
          "$ref": "#/$defs/CapabilityLimitationSource"
        },
        "capability": {
          "$ref": "#/$defs/CapabilityId"
        },
        "explanation": {
          "type": "string"
        },
        "upstream_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "capability",
        "attributed_to",
        "explanation"
      ],
      "type": "object"
    }
  },
  "$id": "https://adversari.al/catalog-bench/schemas/v1/profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A version-pinned environment recipe shared by scenarios and result records.",
  "properties": {
    "catalog_adapters": {
      "description": "Exact routing, authentication, shim, and capability coverage per catalog.",
      "items": {
        "$ref": "#/$defs/CatalogAdapter"
      },
      "type": "array"
    },
    "catalog_capabilities": {
      "description": "Versioned operation vocabulary shared by all catalog adapters.",
      "items": {
        "$ref": "#/$defs/CatalogCapability"
      },
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "type": "array"
    },
    "contract_version": {
      "$ref": "#/$defs/ContractVersion"
    },
    "description": {
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "type": "object"
    },
    "id": {
      "$ref": "#/$defs/ProfileId"
    },
    "kind": {
      "$ref": "#/$defs/ProfileDocumentKind"
    },
    "platform": {
      "$ref": "#/$defs/ExecutionPlatform"
    },
    "purpose": {
      "$ref": "#/$defs/ProfilePurpose"
    },
    "readiness": {
      "$ref": "#/$defs/ProfileReadiness"
    },
    "resolved_at": {
      "description": "RFC 3339 date or timestamp at which moving dependencies were resolved.",
      "type": "string"
    },
    "services": {
      "items": {
        "$ref": "#/$defs/ServiceBinding"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "contract_version",
    "kind",
    "id",
    "title",
    "description",
    "resolved_at",
    "purpose",
    "readiness",
    "platform",
    "components",
    "services"
  ],
  "title": "Profile",
  "type": "object"
}
